rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'safeness.c.a@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isApprovedCoach(uid) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.role == 'coach'
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.approvalStatus == 'approved';
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function validDocument(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType == 'application/pdf';
    }

    function validMedia(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('(image/.*|video/.*|audio/.*|application/pdf)');
    }

    // Public site artwork; only the verified administrator may replace it.
    match /website/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || validImage(10 * 1024 * 1024));
    }

    match /promotions/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || validImage(10 * 1024 * 1024));
    }

    // Catalog and audio assets require an authenticated account.
    match /marketplace/pdfs/{filePath=**} {
      allow read: if signedIn();
      allow write: if isAdmin() && (request.resource == null || validDocument(30 * 1024 * 1024));
    }

    match /pills/audio/{filePath=**} {
      allow read: if signedIn();
      allow write: if isAdmin() && (request.resource == null || (request.resource.size < 30 * 1024 * 1024 && request.resource.contentType.matches('audio/.*')));
    }

    // Coach-owned profile, welcome-video and resource files.
    match /coaches/{uid}/{filePath=**} {
      allow read: if signedIn();
      allow write: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && isApprovedCoach(uid)
        && (request.resource == null || validMedia(50 * 1024 * 1024))
      );
    }

    // Course cover and lesson media are written only by the approved owner coach.
    match /courses/{uid}/{filePath=**} {
      allow read: if signedIn();
      allow write: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && isApprovedCoach(uid)
        && validMedia(50 * 1024 * 1024)
      );
    }

    // No unclassified upload path is writable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
